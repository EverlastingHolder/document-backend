FROM golang:1.27.3-alpine3.24 AS build

WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 GOOS=linux go build -trimpath -ldflags="-s -w" -o /out/passport-api ./cmd/api

FROM alpine:3.24

RUN apk add --no-cache ca-certificates su-exec \
    && mkdir -p /run/passport-api
COPY --from=build /out/passport-api /usr/local/bin/passport-api
COPY deploy/api-entrypoint.sh /usr/local/bin/passport-api-entrypoint
RUN chmod 0755 /usr/local/bin/passport-api /usr/local/bin/passport-api-entrypoint

EXPOSE 8080
ENTRYPOINT ["/usr/local/bin/passport-api-entrypoint"]
