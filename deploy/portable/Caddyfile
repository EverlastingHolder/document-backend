{
	admin off
	auto_https off
	http_port 8080
	https_port 8443
}

(api_routes) {
	@enroll {
		method POST
		path /v1/client-installations
	}
	@submit {
		method POST
		path /v1/passport/jobs
	}
	@status {
		method GET
		path_regexp job_status ^/v1/passport/jobs/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}$
	}
	@receipt {
		method POST
		path_regexp job_receipt ^/v1/passport/jobs/[0-9a-fA-F]{8}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{4}-[0-9a-fA-F]{12}/receipt$
	}
	handle @enroll {
		reverse_proxy api:8080
	}
	handle @submit {
		reverse_proxy api:8080
	}
	handle @status {
		reverse_proxy api:8080
	}
	handle @receipt {
		reverse_proxy api:8080
	}
}

http://:8080 {
	route {
		import api_routes
		handle {
			respond "not found" 404
		}
	}
}

http://:8081 {
	route {
		import api_routes
		@docs_stats {
			method GET
			path /v1/stats
		}
		handle @docs_stats {
			reverse_proxy api:8080
		}
		@api_namespace path /v1 /v1/*
		handle @api_namespace {
			respond "not found" 404
		}
		@scalar_assets path /scalar.js /openapi/*
		handle @scalar_assets {
			reverse_proxy scalar-reference:8080
		}
		handle {
			root * /srv/scalar-ui
			file_server
		}
	}
}
