# Default to this machine only. For LAN access, change this to the host's
# private IPv4 address and allow TCP 8080 only from the trusted LAN.
PASSPORT_PUBLIC_BIND=127.0.0.1

# Swagger UI is a separate listener and stays local even when the API is LAN-bound.
# Change this only if you intend to expose the API documentation to the LAN.
PASSPORT_DOCS_BIND=127.0.0.1
